<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>แก้ไขหนังสือรับรอง — <%= form.certificateNo %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style> body{ font-family:'Noto Sans Thai',system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial,'Noto Sans','Liberation Sans',sans-serif; } </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-emerald-50 via-teal-50 to-cyan-50">
  <header class="bg-gradient-to-r from-emerald-700 to-teal-600 text-white shadow">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
      <h1 class="text-lg md:text-xl font-bold">แก้ไขหนังสือรับรอง</h1>
      <div class="flex gap-2">
        <a href="/" class="px-3 py-1.5 rounded-lg bg-white/20 text-white text-sm hover:bg-white/30">เมนูหลัก</a>
        <a href="/certificate/list" class="px-3 py-1.5 rounded-lg bg-white text-emerald-800 text-sm hover:bg-emerald-100">รายการหนังสือรับรอง</a>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto p-4 md:p-6">
    <% if (error) { %>
      <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 text-rose-700 px-4 py-3"><strong>ผิดพลาด:</strong> <%= error %></div>
    <% } %>

    <form class="bg-white/95 border border-emerald-100 rounded-2xl p-4 md:p-6 space-y-5 shadow"
          action="/certificate/update/<%= form.id %>" method="post" enctype="multipart/form-data">

      <!-- เลขที่รับรอง -->
      <div>
        <label class="block text-sm text-emerald-900 mb-1">เลขที่รับรอง <span class="text-red-600">*</span></label>
        <input name="certificateNo" type="text" required
               class="w-full rounded-xl border border-emerald-300 focus:border-teal-500 focus:ring-teal-500 bg-white"
               value="<%= form.certificateNo || '' %>" />
      </div>

      <!-- เรื่อง -->
      <div>
        <label class="block text-sm text-emerald-900 mb-1">เรื่อง</label>
        <input name="subject" type="text"
               class="w-full rounded-xl border border-emerald-300 focus:border-teal-500 focus:ring-teal-500 bg-white"
               value="<%= form.subject || '' %>" />
      </div>

      <!-- ออกให้ ณ วันที่ -->
      <div>
        <label class="block text-sm text-emerald-900 mb-1">ออกให้ ณ วันที่</label>
        <input name="issueDate" type="date"
               class="w-full rounded-xl border border-emerald-300 focus:border-teal-500 focus:ring-teal-500 bg-white"
               value="<%= form.issueDate || '' %>" />
      </div>

      <!-- การปฏิบัติ -->
      <div>
        <label class="block text-sm text-emerald-900 mb-1">การปฏิบัติ</label>
        <select name="department"
                class="w-full rounded-xl border border-emerald-300 focus:border-teal-500 focus:ring-teal-500 bg-white">
          <option value="">-- เลือกหน่วยงาน --</option>
          <% const deps = ['สำนักปลัด','กองคลัง','กองช่าง','กองสวัสดิการสังคม','กองสาธารณสุข','หน่วยตรวจสอบภายใน','นิติกร','ป้องกัน','ฝ่ายนโยบายและแผน','ฝ่ายทรัพยากรบุคคล','ฝ่ายบริหารงานทั่วไป']; %>
          <% deps.forEach(d => { %>
            <option value="<%= d %>" <%= (form.department||'')===d ? 'selected' : '' %>><%= d %></option>
          <% }) %>
        </select>
      </div>

      <!-- แนบไฟล์ PDF -->
      <div>
        <label class="block text-sm text-emerald-900 mb-1">ไฟล์แนบ PDF</label>
        <div class="flex items-center gap-3">
          <input name="pdfFile" type="file" accept="application/pdf"
                 class="flex-1 rounded-xl border border-emerald-300 file:mr-4 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-emerald-700 file:text-white hover:file:bg-emerald-800" />
          <% if (form.pdfPath) { %>
            <a class="text-teal-700 hover:underline whitespace-nowrap" href="<%= form.pdfPath %>" target="_blank">ดูไฟล์เดิม</a>
          <% } %>
        </div>
        <p class="text-xs text-emerald-700/70 mt-1">ถ้าไม่เลือกไฟล์ใหม่ ระบบจะใช้ไฟล์เดิม</p>
      </div>

      <!-- ปุ่ม -->
      <div class="flex justify-center">
        <button type="submit" class="px-4 py-2 rounded-xl text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:opacity-90 shadow-sm">บันทึกการแก้ไข</button>
      </div>
    </form>
  </main>

  <!-- Toast -->
  <div id="toastSaved" class="hidden fixed top-4 right-4 z-50"><div class="rounded-xl bg-emerald-600 text-white shadow-lg px-4 py-3">✅ บันทึกสำเร็จ</div></div>
  <script>
    (function(){
      const p = new URLSearchParams(location.search);
      if (p.get('saved') === '1') {
        const t = document.getElementById('toastSaved');
        t.classList.remove('hidden'); setTimeout(()=> t.classList.add('hidden'), 2000);
      }
    })();
  </script>
</body>
</html>
