<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>แก้ไขคำสั่ง — <%= form.orderNo %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style> body{ font-family:'Noto Sans Thai',system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial,'Noto Sans','Liberation Sans',sans-serif; } </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-stone-50">
  <header class="bg-gradient-to-r from-amber-700 to-stone-600 text-white shadow-md">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
      <h1 class="text-lg md:text-xl font-bold">🛠️ แก้ไขคำสั่ง</h1>
      <div class="flex gap-2">
        <a href="/" class="px-3 py-1.5 rounded-lg bg-white/20 text-white text-sm hover:bg-white/30">เมนูหลัก</a>
        <a href="/order/list" class="px-3 py-1.5 rounded-lg bg-white text-amber-800 text-sm hover:bg-amber-100">รายการคำสั่ง</a>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto p-4 md:p-6">
    <% if (error) { %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 text-red-700 px-4 py-3">
      <strong>ผิดพลาด:</strong> <%= error %>
    </div>
    <% } %>

    <form class="bg-white/95 border border-stone-200 rounded-2xl p-4 md:p-6 space-y-5 shadow-lg"
          action="/order/update/<%= form.id %>" method="post" enctype="multipart/form-data">

      <!-- เลขที่คำสั่ง -->
      <div class="p-3 rounded-xl bg-amber-50 border border-amber-200">
        <label class="block text-sm font-semibold text-amber-800 mb-1">เลขที่คำสั่ง <span class="text-red-600">*</span></label>
        <input name="orderNo" type="text" required
               class="w-full rounded-xl border border-amber-300 focus:border-orange-500 focus:ring-orange-500 bg-white"
               value="<%= form.orderNo || '' %>" />
      </div>

      <!-- เรื่อง -->
      <div class="p-3 rounded-xl bg-stone-50 border border-stone-200">
        <label class="block text-sm font-semibold text-stone-700 mb-1">เรื่อง</label>
        <input name="subject" type="text"
               class="w-full rounded-xl border border-stone-300 focus:border-amber-500 focus:ring-amber-500 bg-white"
               value="<%= form.subject || '' %>" />
      </div>

      <!-- สั่ง ณ วันที่ -->
      <div class="p-3 rounded-xl bg-orange-50 border border-orange-200">
        <label class="block text-sm font-semibold text-orange-700 mb-1">สั่ง ณ วันที่</label>
        <input name="orderDate" type="date"
               class="w-full rounded-xl border border-orange-300 focus:border-orange-500 focus:ring-orange-500 bg-white"
               value="<%= form.orderDate || '' %>" />
      </div>

      <!-- การปฏิบัติ -->
      <div class="p-3 rounded-xl bg-stone-50 border border-stone-200">
        <label class="block text-sm font-semibold text-stone-700 mb-1">การปฏิบัติ</label>
        <select name="department"
                class="w-full rounded-xl border border-stone-300 focus:border-amber-500 focus:ring-amber-500 bg-white">
          <option value="">-- เลือกหน่วยงาน --</option>
          <% const deps = ['สำนักปลัด','กองคลัง','กองช่าง','กองสวัสดิการสังคม','กองสาธารณสุข','หน่วยตรวจสอบภายใน','นิติกร','ป้องกัน','ฝ่ายนโยบายและแผน','ฝ่ายทรัพยากรบุคคล','ฝ่ายบริหารงานทั่วไป']; %>
          <% deps.forEach(d => { %>
            <option value="<%= d %>" <%= (form.department||'')===d ? 'selected' : '' %>><%= d %></option>
          <% }) %>
        </select>
      </div>

      <!-- แนบไฟล์ PDF -->
      <div class="p-3 rounded-xl bg-amber-50 border border-amber-200">
        <label class="block text-sm font-semibold text-amber-800 mb-1">ไฟล์แนบ PDF</label>
        <div class="flex items-center gap-3">
          <input name="pdfFile" type="file" accept="application/pdf"
                 class="flex-1 rounded-xl border-amber-300 file:mr-4 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-stone-700 file:text-white hover:file:bg-stone-800 bg-white" />
          <% if (form.pdfPath) { %>
            <a class="text-amber-800 hover:underline whitespace-nowrap" href="<%= form.pdfPath %>" target="_blank">ดูไฟล์เดิม</a>
          <% } %>
        </div>
        <p class="text-xs text-stone-500 mt-1">ถ้าไม่เลือกไฟล์ใหม่ ระบบจะใช้ไฟล์เดิม</p>
      </div>

      <!-- ปุ่ม -->
      <div class="flex justify-center">
        <button type="submit" class="px-4 py-2 rounded-xl bg-gradient-to-r from-amber-600 to-orange-600 text-white hover:opacity-90 shadow">บันทึกการแก้ไข</button>
      </div>
    </form>
  </main>

  <!-- Toast -->
  <div id="toastSaved" class="hidden fixed top-4 right-4 z-50"><div class="rounded-xl bg-emerald-600 text-white shadow-lg px-4 py-3">✅ บันทึกสำเร็จ</div></div>

  <script>
    (function(){
      const params = new URLSearchParams(location.search);
      if (params.get('saved') === '1') {
        const t = document.getElementById('toastSaved');
        t.classList.remove('hidden'); setTimeout(()=> t.classList.add('hidden'), 2000);
      }
    })();
  </script>
</body>
</html>
