<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>รายการหนังสือรับรอง</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    body{ font-family:'Noto Sans Thai',system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial,'Noto Sans','Liberation Sans',sans-serif; }
    thead.sticky th{ position:sticky; top:0; z-index:1; }
  </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-emerald-50 via-teal-50 to-cyan-50">
  <header class="bg-gradient-to-r from-emerald-700 to-teal-600 text-white shadow">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <h1 class="text-xl font-bold">รายการหนังสือรับรอง</h1>
      <div class="flex gap-2">
        <a href="/" class="px-3 py-1.5 rounded-lg bg-white/20 text-white text-sm hover:bg-white/30">เมนูหลัก</a>
        <a href="/certificate/new" class="px-3 py-1.5 rounded-lg bg-white text-emerald-800 text-sm hover:bg-emerald-100">เพิ่มรายการ</a>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto p-4 md:p-6 space-y-4">
    <!-- Toolbar -->
    <div class="bg-white/95 border border-emerald-100 rounded-2xl p-3 md:p-4 flex flex-col md:flex-row md:items-center gap-3 shadow">
      <form method="get" action="/certificate/list" class="flex items-center gap-2">
        <input type="text" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>"
               class="rounded-xl border-emerald-300 focus:border-teal-500 focus:ring-teal-500 w-72 bg-white"
               placeholder="ค้นหา: เลขที่รับรอง/เรื่อง/หน่วยงาน" />
        <button class="px-3 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 text-white hover:opacity-90" type="submit">ค้นหา</button>
        <a href="/certificate/list" class="px-3 py-2 rounded-xl bg-stone-200 text-stone-800 hover:bg-stone-300">ล้าง</a>
      </form>
      <div class="md:ml-auto">
        <a href="/certificate/export<% if (q) { %>?q=<%= encodeURIComponent(q) %><% } %>"
           class="px-3 py-2 rounded-xl bg-emerald-600 text-white hover:bg-emerald-700">Export Excel</a>
      </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto bg-white/95 rounded-2xl border border-emerald-100 shadow">
      <table class="min-w-full text-sm">
        <thead class="sticky top-0 bg-gradient-to-r from-emerald-100 to-teal-100 text-emerald-900">
          <tr class="*:[&>th]:px-3 *:[&>th]:py-2">
            <th class="text-center w-32">เลขที่รับรอง</th>
            <th class="text-center w-40">ออกให้ ณ วันที่</th>
            <th class="text-center">เรื่อง</th>
            <th class="text-center w-40">การปฏิบัติ</th>
            <th class="text-center w-28">ไฟล์</th>
            <th class="text-center w-32">จัดการ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-emerald-50 *:[&>tr>td]:px-3 *:[&>tr>td]:py-2 *:[&>tr>td]:text-center">
  <% if (!items || items.length === 0) { %>
    <tr>
      <td colspan="6" class="px-3 py-8 text-center text-emerald-700/50">ยังไม่มีข้อมูล</td>
    </tr>
  <% } else { %>
    <% items.forEach(row => { %>
      <tr class="hover:bg-emerald-50/60">
        <!-- เลขที่หนังสือ -->
        <td class="font-medium text-emerald-900 text-center"><%= row.certificateNo %></td>

        <!-- วันที่ออก -->
        <td class="text-emerald-800 text-center"><%= row.issueDate || '-' %></td>

        <!-- เรื่อง -->
        <td>
          <span class="block truncate" title="<%= row.subject || '' %>">
            <%= row.subject 
                ? (row.subject.length > 20 ? row.subject.substring(0,20) + '...' : row.subject) 
                : '-' %>
          </span>
        </td>

        <!-- หน่วยงาน -->
        <td class="truncate max-w-[26ch]" title="<%= row.department || '' %>">
          <%= row.department || '-' %>
        </td>

        <!-- ไฟล์ PDF -->
        <td>
          <% if (row.pdfPath) { %>
            <a class="block w-full text-center text-teal-700 hover:underline"
               href="<%= row.pdfPath %>" target="_blank">ดู PDF</a>
          <% } else { %>
            <span class="block w-full text-center">-</span>
          <% } %>
        </td>
        <td>
          <div class="flex justify-center gap-2">
            <a class="inline-block px-2.5 py-1.5 rounded-lg bg-amber-500 text-white hover:bg-amber-600"
               href="/certificate/edit/<%= row.id %>">แก้ไข</a>
            <button type="button"
                    class="inline-block px-2.5 py-1.5 rounded-lg bg-rose-600 text-white hover:bg-rose-700"
                    onclick="openDeleteModal('<%= row.id %>', '<%= row.certificateNo %>')">ลบ</button>
          </div>
        </td>
      </tr>
    <% }) %>
  <% } %>
        </tbody>
      </table>
    </div>
  </main>

  <!-- Pagination -->
  <div class="p-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col items-center gap-3">
        <div class="text-sm text-emerald-900/80 text-center">
          แสดง <%= items.length %> รายการ จากทั้งหมด <%= total %> | หน้า <%= page %>/<%= pages %>
        </div>

        <div class="flex items-center gap-1">
          <%
            function linkTo(p){
              const qs = [];
              if (q) qs.push('q=' + encodeURIComponent(q));
              if (p > 1) qs.push('page=' + p);
              const qstr = qs.length ? ('?' + qs.join('&')) : '';
              return '/certificate/list' + qstr;
            }
          %>
          <% if (page > 1) { %>
            <a href="<%= linkTo(page - 1) %>" class="px-3 py-1.5 rounded-lg border border-emerald-200 hover:bg-emerald-50">ก่อนหน้า</a>
          <% } else { %>
            <span class="px-3 py-1.5 rounded-lg border border-emerald-100 bg-emerald-50 text-emerald-400 cursor-not-allowed">ก่อนหน้า</span>
          <% } %>
          <% for (let p = 1; p <= pages; p++) { %>
            <% if (p === page) { %>
              <span class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white">
                <%= p %>
              </span>
            <% } else { %>
              <a href="<%= linkTo(p) %>" class="px-3 py-1.5 rounded-lg border border-emerald-200 hover:bg-emerald-50"><%= p %></a>
            <% } %>
          <% } %>
          <% if (page < pages) { %>
            <a href="<%= linkTo(page + 1) %>" class="px-3 py-1.5 rounded-lg border border-emerald-200 hover:bg-emerald-50">ถัดไป</a>
          <% } else { %>
            <span class="px-3 py-1.5 rounded-lg border border-emerald-100 bg-emerald-50 text-emerald-400 cursor-not-allowed">ถัดไป</span>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL ลบ -->
  <div id="deleteModal" class="hidden fixed inset-0 z-50 items-center justify-center">
    <div class="absolute inset-0 bg-black/40" onclick="closeDeleteModal()"></div>
    <div class="relative bg-white rounded-2xl shadow-xl w-[90%] max-w-md p-5">
      <h3 class="text-lg font-semibold text-emerald-900">ยืนยันการลบ</h3>
      <p class="text-sm text-emerald-800 mt-1">กรุณาใส่รหัสผ่านเพื่อยืนยันการลบรายการ <span id="delNo" class="font-medium text-emerald-900"></span></p>
      <form id="deleteForm" class="mt-4" method="post">
        <label class="block text-sm text-emerald-900 mb-1">รหัสผ่าน</label>
        <input type="password" name="password" id="delPassword" required
               class="w-full rounded-xl border-emerald-300 focus:border-rose-500 focus:ring-rose-500"
               placeholder="ใส่รหัสผ่านหรือติดต่อแอดมิน" />
        <div class="mt-4 flex justify-end gap-2">
          <button type="button" class="px-3 py-1.5 rounded-lg bg-stone-200 text-stone-800 hover:bg-stone-300" onclick="closeDeleteModal()">ยกเลิก</button>
          <button type="submit" class="px-3 py-1.5 rounded-lg bg-rose-600 text-white hover:bg-rose-700">ลบรายการ</button>
        </div>
      </form>
    </div>
  </div>

  <!-- TOASTS -->
  <div id="toastDeleted" class="hidden fixed top-4 right-4 z-50"><div class="rounded-xl bg-emerald-600 text-white shadow-lg px-4 py-3">🗑️ ลบสำเร็จ</div></div>
  <div id="toastDelErr" class="hidden fixed top-4 right-4 z-50"><div class="rounded-xl bg-rose-600 text-white shadow-lg px-4 py-3">❌ รหัสผ่านไม่ถูกต้อง</div></div>

  <script>
    function openDeleteModal(id, no){
      const modal = document.getElementById('deleteModal');
      const form = document.getElementById('deleteForm');
      const label = document.getElementById('delNo');
      const pass = document.getElementById('delPassword');
      form.action = `/certificate/delete/${id}`;
      label.textContent = no ? `เลขที่รับรอง ${no}` : '';
      pass.value = '';
      modal.classList.remove('hidden'); modal.classList.add('flex');
      setTimeout(()=> pass.focus(), 50);
    }
    function closeDeleteModal(){
      const modal = document.getElementById('deleteModal');
      modal.classList.add('hidden'); modal.classList.remove('flex');
    }
    (function(){
      const p = new URLSearchParams(location.search);
      if (p.get('deleted') === '1'){
        const t = document.getElementById('toastDeleted'); t.classList.remove('hidden'); setTimeout(()=> t.classList.add('hidden'), 2000);
      }
      if (p.get('derr') === '1'){
        const t = document.getElementById('toastDelErr'); t.classList.remove('hidden'); setTimeout(()=> t.classList.add('hidden'), 2500);
      }
    })();
  </script>
</body>
</html>
