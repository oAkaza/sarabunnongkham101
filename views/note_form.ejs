<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>บันทึกข้อความ — ฟอร์ม</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style> body{ font-family: 'Noto Sans Thai', system-ui, sans-serif; } </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-cyan-50 via-teal-50 to-indigo-50">
  <header class="bg-gradient-to-r from-cyan-600 to-indigo-600 text-white shadow-md">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
      <h1 class="text-lg md:text-xl font-bold">📝 บันทึกข้อความ</h1>
      <div class="flex gap-2">
        <a href="/" class="px-3 py-1.5 rounded-lg bg-white/20 text-white text-sm hover:bg-white/30">เมนูหลัก</a>
        <a href="/note/list" class="px-3 py-1.5 rounded-lg bg-white text-cyan-700 text-sm hover:bg-cyan-100">รายการบันทึกข้อความ</a>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto p-4 md:p-6">
    <% if (error) { %>
      <div class="mb-4 rounded-lg border border-red-200 bg-red-50 text-red-700 px-4 py-3">
        <strong>ผิดพลาด:</strong> <%= error %>
      </div>
    <% } %>

    <form class="bg-white/95 border border-slate-200 rounded-2xl p-4 md:p-6 space-y-5 shadow-lg"
          action="/note/create" method="post" enctype="multipart/form-data">

      <!-- เลขที่บันทึก -->
      <div class="p-3 rounded-xl bg-cyan-50 border border-cyan-200">
        <label class="block text-sm font-semibold text-cyan-700 mb-1">เลขที่บันทึก <span class="text-red-600">*</span></label>
        <input name="noteNo" type="text" required
               class="w-full rounded-xl border border-cyan-300 focus:border-indigo-500 focus:ring-indigo-500 bg-white"
               placeholder="เช่น นข.001/2568" />
      </div>

      <!-- ที่ + ลงวันที่ -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-3 rounded-xl bg-teal-50 border border-teal-200">
          <label class="block text-sm font-semibold text-teal-700 mb-1">ที่</label>
          <input name="at" type="text"
                 class="w-full rounded-xl border border-teal-300 focus:border-teal-500 focus:ring-teal-500 bg-white" />
        </div>
        <div class="p-3 rounded-xl bg-indigo-50 border border-indigo-200">
          <label class="block text-sm font-semibold text-indigo-700 mb-1">ลงวันที่</label>
          <input name="signDate" type="date"
                 class="w-full rounded-xl border border-indigo-300 focus:border-indigo-500 focus:ring-indigo-500 bg-white" />
        </div>
      </div>

      <!-- จาก + ถึง -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-3 rounded-xl bg-sky-50 border border-sky-200">
          <label class="block text-sm font-semibold text-sky-700 mb-1">จาก</label>
          <input name="from" type="text" value="องค์การบริหารส่วนตำบลหนองขาม"
                 class="w-full rounded-xl border border-sky-300 focus:border-sky-500 focus:ring-sky-500 bg-white" />
        </div>
        <div class="p-3 rounded-xl bg-cyan-50 border border-cyan-200">
          <label class="block text-sm font-semibold text-cyan-700 mb-1">ถึง</label>
          <input name="to" type="text"
                 class="w-full rounded-xl border border-cyan-300 focus:border-cyan-500 focus:ring-cyan-500 bg-white" />
        </div>
      </div>

      <!-- เรื่อง -->
      <div class="p-3 rounded-xl bg-indigo-50 border border-indigo-200">
        <label class="block text-sm font-semibold text-indigo-700 mb-1">เรื่อง</label>
        <input name="subject" type="text"
               class="w-full rounded-xl border border-indigo-300 focus:border-indigo-500 focus:ring-indigo-500 bg-white" />
      </div>

      <!-- การปฏิบัติ -->
      <div class="p-3 rounded-xl bg-teal-50 border border-teal-200">
        <label class="block text-sm font-semibold text-teal-700 mb-1">การปฏิบัติ</label>
        <select name="department"
                class="w-full rounded-xl border border-teal-300 focus:border-teal-500 focus:ring-teal-500 bg-white">
          <option value="">-- เลือกหน่วยงาน --</option>
          <option>สำนักปลัด</option>
          <option>กองคลัง</option>
          <option>กองช่าง</option>
          <option>กองสวัสดิการสังคม</option>
          <option>กองสาธารณสุข</option>
          <option>หน่วยตรวจสอบภายใน</option>
          <option>นิติกร</option>
          <option>ป้องกัน</option>
          <option>ฝ่ายนโยบายและแผน</option>
          <option>ฝ่ายทรัพยากรบุคคล</option>
          <option>ฝ่ายบริหารงานทั่วไป</option>
        </select>
      </div>

      <!-- แนบไฟล์ PDF -->
      <div class="p-3 rounded-xl bg-sky-50 border border-sky-200">
        <label class="block text-sm font-semibold text-sky-700 mb-1">แนบไฟล์ PDF</label>
        <input name="pdfFile" type="file" accept="application/pdf"
               class="w-full rounded-xl border-sky-300 file:mr-4 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-indigo-600 file:text-white hover:file:bg-indigo-700 bg-white" />
      </div>

      <!-- ปุ่ม -->
      <div class="flex justify-center">
        <button type="submit"
                class="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-600 to-indigo-600 text-white hover:opacity-90 shadow">
          บันทึก
        </button>
      </div>
    </form>
  </main>

  <!-- Toast Popup -->
  <div id="toastSaved" class="hidden fixed top-4 right-4 z-50">
    <div class="rounded-xl bg-emerald-600 text-white shadow-lg px-4 py-3">
      ✅ บันทึกสำเร็จ
    </div>
  </div>

  <script>
    (function(){
      const params = new URLSearchParams(location.search);
      if (params.get('saved') === '1') {
        const t = document.getElementById('toastSaved');
        t.classList.remove('hidden');
        setTimeout(()=> t.classList.add('hidden'), 2000);
      }
    })();
  </script>
</body>
</html>
